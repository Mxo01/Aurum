export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

echo "--- Secret scanning ---"
if command -v gitleaks >/dev/null 2>&1; then
  # "|| STATUS=$?" evita che set -e uccida lo script prima del messaggio
  GITLEAKS_STATUS=0
  # gitleaks >= 8.19 usa "git --staged"; le versioni precedenti "protect --staged"
  if gitleaks git --help >/dev/null 2>&1; then
    gitleaks git --staged --redact --no-banner --config .gitleaks.toml || GITLEAKS_STATUS=$?
  else
    gitleaks protect --staged --redact --no-banner --config .gitleaks.toml || GITLEAKS_STATUS=$?
  fi
  if [ "$GITLEAKS_STATUS" -ne 0 ]; then
    echo ""
    echo "=============================================================="
    echo " COMMIT BLOCCATO: possibile secret nei file staged."
    echo ""
    echo " Sposta il valore in application-local.properties (gitignored)"
    echo " o in una env var, e lascia \${NOME_VAR} nel file committato."
    echo " Vedi application-local.properties.example per le chiavi."
    echo ""
    echo " Falso positivo? Aggiungilo alla allowlist in .gitleaks.toml."
    echo " NON usare --no-verify per aggirare questo controllo."
    echo "=============================================================="
    exit 1
  fi
else
  echo "ATTENZIONE: gitleaks non installato, scan dei secret SALTATO."
  echo "Installalo con:  brew install gitleaks"
fi

echo "--- Checking Aurum FE ---"
(cd aurum-fe && npx lint-staged)

echo "--- Checking Aurum BE ---"
STAGED_JAVA=$(git diff --cached --name-only --diff-filter=ACM | grep "aurum-be/.*\.java$" || true)
echo "Staged Java files: '$STAGED_JAVA'"
if [ -n "$STAGED_JAVA" ]; then
  echo "$STAGED_JAVA" | xargs ./node_modules/.bin/prettier --write --log-level log
  echo "$STAGED_JAVA" | xargs git add
  echo "Done formatting and re-staging"
else
  echo "No staged Java files, skipping"
fi