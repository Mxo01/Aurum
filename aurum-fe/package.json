{
	"name": "aurum-fe",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "npm run typecheck && vite build",
		"preview": "vite preview",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"api:types": "openapi-typescript ../aurum-be/openapi.json -o src/lib/api/schema.d.ts",
		"start": "vite",
		"format": "prettier . --write",
		"clean-code": "npm run lint && npm run format"
	},
	"dependencies": {
		"@auth0/auth0-react": "^2.30.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@fontsource-variable/plus-jakarta-sans": "^5.3.0",
		"@hookform/resolvers": "^7.0.6",
		"@radix-ui/react-alert-dialog": "^1.2.1",
		"@radix-ui/react-avatar": "^1.3.1",
		"@radix-ui/react-checkbox": "^1.4.1",
		"@radix-ui/react-dialog": "^1.3.1",
		"@radix-ui/react-dropdown-menu": "^2.2.1",
		"@radix-ui/react-label": "^2.1.17",
		"@radix-ui/react-popover": "^1.3.1",
		"@radix-ui/react-progress": "^1.2.1",
		"@radix-ui/react-radio-group": "^1.5.1",
		"@radix-ui/react-select": "^2.4.1",
		"@radix-ui/react-separator": "^1.2.0",
		"@radix-ui/react-slot": "^1.5.0",
		"@radix-ui/react-switch": "^1.4.1",
		"@radix-ui/react-tabs": "^1.2.1",
		"@radix-ui/react-toggle": "^1.2.1",
		"@radix-ui/react-toggle-group": "^1.2.1",
		"@radix-ui/react-tooltip": "^1.4.1",
		"@tanstack/react-query": "^5.107.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.4.0",
		"lucide-react": "^1.72.0",
		"openapi-fetch": "^0.17.0",
		"react": "^19.3.1",
		"react-day-picker": "^10.0.2",
		"react-dom": "^19.3.1",
		"react-hook-form": "^7.92.0",
		"react-router": "^8.5.1",
		"recharts": "^3.10.1",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.0",
		"vaul": "^1.1.2",
		"zod": "^4.6.7",
		"zustand": "^5.1.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^9.39.5",
		"@faker-js/faker": "^10.6.0",
		"@playwright/test": "^1.65.0",
		"@tailwindcss/vite": "^4.3.5",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.10",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"@vitest/coverage-v8": "^4.1.12",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.7",
		"globals": "^17.14.0",
		"happy-dom": "^21.0.4",
		"jsdom": "^31.0.1",
		"msw": "^2.15.0",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.10.1",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^4.1.12"
	},
	"lint-staged": {
		"*.{js,ts,tsx,css,json,html}": [
			"eslint --fix",
			"prettier --write"
		]
	}
}
